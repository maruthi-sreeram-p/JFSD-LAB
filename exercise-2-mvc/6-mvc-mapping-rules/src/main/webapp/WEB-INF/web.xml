<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>MVC Mapping Rules</display-name>

    <!-- 1. exact match -->
    <servlet>
        <servlet-name>exactServlet</servlet-name>
        <servlet-class>com.jfsd.mvc.MappingServlet</servlet-class>
        <init-param>
            <param-name>pattern</param-name>
            <param-value>/home</param-value>
        </init-param>
        <init-param>
            <param-name>rule</param-name>
            <param-value>exact match - the path must be exactly /home</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>exactServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- 2. path match: starts with / and ends with /* -->
    <servlet>
        <servlet-name>adminServlet</servlet-name>
        <servlet-class>com.jfsd.mvc.MappingServlet</servlet-class>
        <init-param>
            <param-name>pattern</param-name>
            <param-value>/admin/*</param-value>
        </init-param>
        <init-param>
            <param-name>rule</param-name>
            <param-value>path match - anything that starts with /admin/</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>adminServlet</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <!-- 3. a longer path pattern beats the shorter one above -->
    <servlet>
        <servlet-name>reportsServlet</servlet-name>
        <servlet-class>com.jfsd.mvc.MappingServlet</servlet-class>
        <init-param>
            <param-name>pattern</param-name>
            <param-value>/admin/reports/*</param-value>
        </init-param>
        <init-param>
            <param-name>rule</param-name>
            <param-value>longest path match - /admin/reports/... is also under /admin/*, but this pattern is longer so it wins</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>reportsServlet</servlet-name>
        <url-pattern>/admin/reports/*</url-pattern>
    </servlet-mapping>

    <!-- 4. extension match: starts with *. -->
    <servlet>
        <servlet-name>extensionServlet</servlet-name>
        <servlet-class>com.jfsd.mvc.MappingServlet</servlet-class>
        <init-param>
            <param-name>pattern</param-name>
            <param-value>*.do</param-value>
        </init-param>
        <init-param>
            <param-name>rule</param-name>
            <param-value>extension match - any path that ends with .do (often used by front controllers)</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>extensionServlet</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <!-- 5. default servlet: used only when nothing else matches -->
    <servlet>
        <servlet-name>fallbackServlet</servlet-name>
        <servlet-class>com.jfsd.mvc.FallbackServlet</servlet-class>
        <init-param>
            <param-name>pattern</param-name>
            <param-value>/</param-value>
        </init-param>
        <init-param>
            <param-name>rule</param-name>
            <param-value>default servlet - no other pattern matched this URL</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>fallbackServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
</web-app>
