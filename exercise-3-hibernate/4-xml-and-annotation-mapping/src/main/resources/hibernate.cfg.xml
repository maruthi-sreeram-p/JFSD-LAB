<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- database connection (H2 in memory, so nothing to install) -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:labdb;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- for MySQL use these instead:
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/jfsd</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">your password</property>
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>
        -->

        <!-- create the tables from the mappings every time the program starts -->
        <property name="hibernate.hbm2ddl.auto">create</property>
        <property name="hibernate.show_sql">true</property>

        <!-- XML mapping file -->
        <mapping resource="Student.hbm.xml"/>
        <!-- annotated class -->
        <mapping class="com.jfsd.hibernate.Employee"/>
    </session-factory>
</hibernate-configuration>
