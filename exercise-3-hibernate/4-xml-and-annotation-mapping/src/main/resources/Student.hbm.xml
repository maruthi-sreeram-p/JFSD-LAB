<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.jfsd.hibernate">

    <!-- class Student  ->  table students_xml -->
    <class name="Student" table="students_xml">

        <id name="id" column="student_id">
            <generator class="native"/>
        </id>

        <property name="name"   column="student_name" length="100" not-null="true"/>
        <property name="email"  column="email"/>
        <property name="course" column="course"/>

    </class>
</hibernate-mapping>
